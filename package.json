{
  "name": "fast-multisort",
  "version": "0.1.0",
  "description": "Stable multi-key sort for arrays of records: radix for numbers, buckets for strings, lodash orderBy semantics.",
  "keywords": [
    "sort",
    "sortBy",
    "orderBy",
    "multisort",
    "radix",
    "stable",
    "fast"
  ],
  "author": "Nikita <dev.nkh@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "pnpm run build && node --max-old-space-size=32768 benchmark/index.js",
    "size": "pnpm run build && node -e \"const z=require('zlib'),f=require('fs');const b=f.readFileSync('dist/index.mjs');console.log(b.length,'B raw',z.brotliCompressSync(b).length,'B brotli')\"",
    "bench:readme": "node --max-old-space-size=32768 benchmark/index.js > benchmark/results.md && node benchmark/update-readme.js",
    "bench:browsers": "pnpm run build && node benchmark/browsers.js",
    "bench:memory": "pnpm run build && node --max-old-space-size=32768 benchmark/memory.js",
    "bench:report": "node benchmark/report.js"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.10.1",
    "@types/ramda": "^0.32.0",
    "@types/underscore": "^1.13.0",
    "array-sort": "^1.0.0",
    "es-toolkit": "^1.49.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "fast-sort": "^3.4.1",
    "just-sort-by": "^3.2.0",
    "lodash": "^4.18.1",
    "natural-orderby": "^5.0.0",
    "playwright": "1.64.0",
    "ramda": "^0.32.0",
    "remeda": "^2.51.0",
    "sort-array": "^5.0.0",
    "sort-by": "^1.2.0",
    "sort-on": "^7.0.0",
    "thenby": "^1.4.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "underscore": "^1.13.8",
    "vitest": "^4.0.0"
  }
}
